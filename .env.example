# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://app.gtautocollisionpr.com

# Administrador del panel (mínimo 12 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe — empieza con la clave de PRUEBA (sk_test_...). La real (sk_live_...) solo cuando el taller lo apruebe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reservado (no implementado todavía)
NOTIFY_PROVIDER=
MITCHELL_API_BASE_URL=
MITCHELL_API_KEY=
